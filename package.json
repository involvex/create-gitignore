{
  "name": "create-gitignore",
  "version": "0.1.0",
  "description": "A .gitignore generator",
  "main": "lib/index.js",
  "scripts": {
    "start": "node lib",
    "compile": "babel -d lib/ src/",
    "dev": "babel -d lib/ src/ --copy-files --watch",
    "test": "mocha --compilers js:babel-register",
    "prepublish": "npm run compile"
  },
  "keywords": [
    "gitignore",
    "generator",
    "git"
  ],
  "author": "Involvex",
  "license": "MIT",
  "devDependencies": {
    "babel-cli": "^6.11.4",
    "babel-preset-es2015": "^6.13.2",
    "babel-preset-stage-2": "^6.13.0",
    "chai": "^6.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Razr9/create-gitignore.git"
  },
  "bin": "./lib/index.js",
  "dependencies": {
    "axios": "^0.13.1",
    "chalk": "^1.1.3",
    "inquirer": "^1.1.2",
    "minimist": "^1.2.0"
  },
  "trustedDependencies": [
    "core-js",
    "spawn-sync"
  ]
}
